VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Web Push (S6) — client public key; generate: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# Server secrets: Edge Secrets OR public.push_config rows (service_role / RLS):
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, CRON_SECRET
# Hourly cron: .github/workflows/push-reminders.yml (PUSH_CRON_SECRET, SUPABASE_PUSH_FUNCTION_URL)
# Optional Sentry (S4)
VITE_SENTRY_DSN=
